# ── Environment variables for SmartHire server ───────────────
# Copy this file to ".env" and fill in your real values.
# NEVER commit your real ".env" file to Git.

# Port the Express server will listen on
PORT=5000

# Your MongoDB connection string
# Get this from MongoDB Atlas → Connect → Drivers
# Example format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/smarthire
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/smarthire
